# 해커톤에서 받은 OpenAI 호환 API 정보를 넣고 파일 이름을 .env 로 바꾸세요.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini
STT_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy

# 단계 시작 때 "이전 작업자 N명이 물어본 것"을 조용히 띄울지 (3절 A안, 아직 미정)
PRIOR_HINTS=0

# 자연스러운 AI 음성 (있으면 먼저 씀, 없으면 노트북 Supertonic 음성)
# Gemini: https://aistudio.google.com/apikey 에서 키 만들기
GEMINI_API_KEY=
# GEMINI_VOICE=Kore
# 또는 OpenAI 음성 (gpt-4o-mini-tts, 랩 프록시 키와 별개인 OpenAI 키)
OPENAI_API_KEY=
# OPENAI_VOICE=marin
# 무료 Gemini는 느리고(한 문장 5~27초) 1분 3번이라 기본은 끔. 결제를 켜 빨라지면 1로
# TTS_USE_GEMINI=1
